    <rdfs:label xml:lang="uk">кількість транспортних засобів</rdfs:label>
    <rdfs:comment>Кількість транспортних засобів, зафіксованих у транспортному потоці або відповідних даних.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/transport-ontology#VehicleCountData"/>
