    <rdfs:label xml:lang="uk">Правило перевантаженого перехрестя</rdfs:label>
    <transport-ontology:description>Правило визначення необхідності регулювання руху на перевантаженому перехресті.</transport-ontology:description>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/transport-ontology#Car003">
