  <rdf:Description rdf:about="http://example.org/transport-ontology#RuleHighCongestion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/transport-ontology#DecisionRule"/>
    <rdfs:label xml:lang="uk">Правило високого завантаження</rdfs:label>
    <transport-ontology:description>
            Якщо рівень завантаженості дороги високий, необхідно змінити маршрут.
        </transport-ontology:description>
    <transport-ontology:determines rdf:resource="http://example.org/transport-ontology#AlternativeRouteDecision"/>
  </rdf:Description>
