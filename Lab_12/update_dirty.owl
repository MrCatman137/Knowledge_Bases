    <rdfs:subClassOf rdf:resource="http://example.org/transport-ontology#TransportEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/transport-ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="uk">Онтологія цифрової моделі транспортної системи</rdfs:label>
    <rdfs:comment xml:lang="uk">
            Онтологія для представлення структури цифрової транспортної системи,
            її об'єктів, процесів, подій, даних, інформації, правил та рішень.
        </rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/transport-ontology#RuleRoadClosure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
