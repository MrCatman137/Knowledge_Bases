    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="uk">характеризує</rdfs:label>
    <rdfs:range rdf:resource="http://example.org/transport-ontology#RoadSegment"/>
    <rdfs:domain rdf:resource="http://example.org/transport-ontology#TrafficFlow"/>
  </rdf:Description>
