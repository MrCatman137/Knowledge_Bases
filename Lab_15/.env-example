# Налаштування хоста та портів
API_HOST=127.0.0.1
API_PORT=8000

# Шлях до онтології
ONTOLOGY_PATH=update_expanded.owl

# Векторні налаштування
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_SIMILARITY_THRESHOLD=0.45

# Обмеження безпеки та якості
MAX_QUERY_LENGTH=500
MAX_ANSWER_TOKENS=350

# Опціонально: якщо є ключ OpenAI / Groq (якщо порожньо — працює якісний вбудований Neural-Rule Synthesis)
LLM_PROVIDER=
OPENAI_API_KEY=

GEMINI_API_KEY=