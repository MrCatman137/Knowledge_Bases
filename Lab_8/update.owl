<?xml version="1.0"?>


<!DOCTYPE rdf:RDF [
    <!ENTITY schema "http://schema.org/" >
    <!ENTITY owl "http://www.w3.org/2002/07/owl#" >
    <!ENTITY dc "http://purl.org/dc/elements/1.1/" >
    <!ENTITY xsd "http://www.w3.org/2001/XMLSchema#" >
    <!ENTITY xml "http://www.w3.org/XML/1998/namespace" >
    <!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#" >
    <!ENTITY transport-ontology "http://example.org/transport-ontology#" >
    <!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#" >
]>


<rdf:RDF xmlns="http://example.org/transport#"
     xml:base="http://example.org/transport"
     xmlns:schema="http://schema.org/"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:transport-ontology="http://example.org/transport-ontology#"
     xmlns:dc="http://purl.org/dc/elements/1.1/">
    <owl:Ontology rdf:about="http://example.org/transport-ontology">
        <rdfs:label xml:lang="uk">Онтологія цифрової моделі транспортної системи</rdfs:label>
        <rdfs:comment xml:lang="uk">
            Онтологія для представлення структури цифрової транспортної системи,
            її об&apos;єктів, процесів, подій, даних, інформації, правил та рішень.
        </rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/transport-ontology#affects -->

    <owl:ObjectProperty rdf:about="&transport-ontology;affects">
        <rdfs:label xml:lang="uk">впливає на</rdfs:label>
        <rdfs:range rdf:resource="&transport-ontology;TrafficFlow"/>
        <rdfs:domain rdf:resource="&transport-ontology;TransportEvent"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/transport-ontology#changes -->

    <owl:ObjectProperty rdf:about="&transport-ontology;changes">
        <rdfs:label xml:lang="uk">змінює</rdfs:label>
        <rdfs:range rdf:resource="&transport-ontology;Route"/>
        <rdfs:domain rdf:resource="&transport-ontology;TransportDecision"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/transport-ontology#characterizes -->

    <owl:ObjectProperty rdf:about="&transport-ontology;characterizes">
        <rdfs:label xml:lang="uk">характеризує</rdfs:label>
        <rdfs:range rdf:resource="&transport-ontology;RoadSegment"/>
        <rdfs:domain rdf:resource="&transport-ontology;TrafficFlow"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/transport-ontology#collectsData -->

    <owl:ObjectProperty rdf:about="&transport-ontology;collectsData">
        <rdfs:label xml:lang="uk">збирає дані</rdfs:label>
        <rdfs:domain rdf:resource="&transport-ontology;DataSource"/>
        <rdfs:range rdf:resource="&transport-ontology;TransportSystemData"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/transport-ontology#contains -->

    <owl:ObjectProperty rdf:about="&transport-ontology;contains">
        <rdfs:label xml:lang="uk">містить</rdfs:label>
        <rdfs:domain rdf:resource="&transport-ontology;DigitalTransportModel"/>
        <rdfs:range rdf:resource="&transport-ontology;TransportInfrastructure"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/transport-ontology#describesState -->

    <owl:ObjectProperty rdf:about="&transport-ontology;describesState">
        <rdfs:label xml:lang="uk">описує стан</rdfs:label>
        <rdfs:range rdf:resource="&transport-ontology;SystemStateInformation"/>
        <rdfs:domain rdf:resource="&transport-ontology;TransportSystemData"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/transport-ontology#determines -->

    <owl:ObjectProperty rdf:about="&transport-ontology;determines">
        <rdfs:label xml:lang="uk">визначає</rdfs:label>
        <rdfs:domain rdf:resource="&transport-ontology;DecisionRule"/>
        <rdfs:range rdf:resource="&transport-ontology;TransportDecision"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/transport-ontology#forms -->

    <owl:ObjectProperty rdf:about="&transport-ontology;forms">
        <rdfs:label xml:lang="uk">формує</rdfs:label>
        <rdfs:range rdf:resource="&transport-ontology;TrafficFlow"/>
        <rdfs:domain rdf:resource="&transport-ontology;Vehicle"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/transport-ontology#generalizes -->

    <owl:ObjectProperty rdf:about="&transport-ontology;generalizes">
        <rdfs:label xml:lang="uk">узагальнює</rdfs:label>
        <rdfs:range rdf:resource="&transport-ontology;DecisionRule"/>
        <rdfs:domain rdf:resource="&transport-ontology;SystemStateInformation"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/transport-ontology#hasBusStop -->

    <owl:ObjectProperty rdf:about="&transport-ontology;hasBusStop">
        <rdfs:label xml:lang="uk">має транспортну зупинку</rdfs:label>
        <rdfs:range rdf:resource="&transport-ontology;BusStop"/>
        <rdfs:domain rdf:resource="&transport-ontology;RoadNetwork"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/transport-ontology#hasIntersection -->

    <owl:ObjectProperty rdf:about="&transport-ontology;hasIntersection">
        <rdfs:label xml:lang="uk">має перехрестя</rdfs:label>
        <rdfs:range rdf:resource="&transport-ontology;Intersection"/>
        <rdfs:domain rdf:resource="&transport-ontology;RoadNetwork"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/transport-ontology#hasRoadNetwork -->

    <owl:ObjectProperty rdf:about="&transport-ontology;hasRoadNetwork">
        <rdfs:label xml:lang="uk">має дорожню мережу</rdfs:label>
        <rdfs:domain rdf:resource="&transport-ontology;DigitalTransportModel"/>
        <rdfs:range rdf:resource="&transport-ontology;RoadNetwork"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/transport-ontology#hasRoadSegment -->

    <owl:ObjectProperty rdf:about="&transport-ontology;hasRoadSegment">
        <rdfs:label xml:lang="uk">має дорожній сегмент</rdfs:label>
        <rdfs:domain rdf:resource="&transport-ontology;RoadNetwork"/>
        <rdfs:range rdf:resource="&transport-ontology;RoadSegment"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/transport-ontology#hasRoute -->

    <owl:ObjectProperty rdf:about="&transport-ontology;hasRoute">
        <rdfs:label xml:lang="uk">має маршрут</rdfs:label>
        <rdfs:range rdf:resource="&transport-ontology;Route"/>
        <rdfs:domain rdf:resource="&transport-ontology;Vehicle"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/transport-ontology#hasTrafficLight -->

    <owl:ObjectProperty rdf:about="&transport-ontology;hasTrafficLight">
        <rdfs:label xml:lang="uk">має світлофор</rdfs:label>
        <rdfs:domain rdf:resource="&transport-ontology;Intersection"/>
        <rdfs:range rdf:resource="&transport-ontology;TrafficLight"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/transport-ontology#hasVehicle -->

    <owl:ObjectProperty rdf:about="&transport-ontology;hasVehicle">
        <rdfs:label xml:lang="uk">має транспортний засіб</rdfs:label>
        <rdfs:domain rdf:resource="&transport-ontology;TrafficFlow"/>
        <rdfs:range rdf:resource="&transport-ontology;Vehicle"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/transport-ontology#locatedOn -->

    <owl:ObjectProperty rdf:about="&transport-ontology;locatedOn">
        <rdfs:label xml:lang="uk">розташований на</rdfs:label>
        <rdfs:range rdf:resource="&transport-ontology;RoadSegment"/>
        <rdfs:domain rdf:resource="&transport-ontology;Vehicle"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/transport-ontology#allowedSpeed -->

    <owl:DatatypeProperty rdf:about="&transport-ontology;allowedSpeed">
        <rdfs:label xml:lang="uk">дозволена швидкість</rdfs:label>
        <rdfs:domain rdf:resource="&transport-ontology;RoadSegment"/>
        <rdfs:range rdf:resource="&xsd;double"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/transport-ontology#currentSpeed -->

    <owl:DatatypeProperty rdf:about="&transport-ontology;currentSpeed">
        <rdfs:label xml:lang="uk">поточна швидкість</rdfs:label>
        <rdfs:range rdf:resource="&xsd;double"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/transport-ontology#description -->

    <owl:DatatypeProperty rdf:about="&transport-ontology;description">
        <rdfs:label xml:lang="uk">опис</rdfs:label>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/transport-ontology#identifier -->

    <owl:DatatypeProperty rdf:about="&transport-ontology;identifier">
        <rdfs:label xml:lang="uk">ідентифікатор</rdfs:label>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/transport-ontology#laneCount -->

    <owl:DatatypeProperty rdf:about="&transport-ontology;laneCount">
        <rdfs:label xml:lang="uk">кількість смуг</rdfs:label>
        <rdfs:domain rdf:resource="&transport-ontology;RoadSegment"/>
        <rdfs:range rdf:resource="&xsd;integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/transport-ontology#latitude -->

    <owl:DatatypeProperty rdf:about="&transport-ontology;latitude">
        <rdfs:label xml:lang="uk">широта</rdfs:label>
        <rdfs:range rdf:resource="&xsd;double"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/transport-ontology#length -->

    <owl:DatatypeProperty rdf:about="&transport-ontology;length">
        <rdfs:label xml:lang="uk">довжина</rdfs:label>
        <rdfs:domain rdf:resource="&transport-ontology;RoadSegment"/>
        <rdfs:range rdf:resource="&xsd;double"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/transport-ontology#longitude -->

    <owl:DatatypeProperty rdf:about="&transport-ontology;longitude">
        <rdfs:label xml:lang="uk">довгота</rdfs:label>
        <rdfs:range rdf:resource="&xsd;double"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/transport-ontology#measurementTime -->

    <owl:DatatypeProperty rdf:about="&transport-ontology;measurementTime">
        <rdfs:label xml:lang="uk">час вимірювання</rdfs:label>
        <rdfs:range rdf:resource="&xsd;dateTime"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/transport-ontology#passengerCount -->

    <owl:DatatypeProperty rdf:about="&transport-ontology;passengerCount">
        <rdfs:label xml:lang="uk">кількість пасажирів</rdfs:label>
        <rdfs:range rdf:resource="&xsd;integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/transport-ontology#routeNumber -->

    <owl:DatatypeProperty rdf:about="&transport-ontology;routeNumber">
        <rdfs:label xml:lang="uk">номер маршруту</rdfs:label>
        <rdfs:domain rdf:resource="&transport-ontology;Route"/>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/transport-ontology#vehicleCount -->

    <owl:DatatypeProperty rdf:about="&transport-ontology;vehicleCount">
        <rdfs:label xml:lang="uk">кількість транспортних засобів</rdfs:label>
        <rdfs:comment>Кількість транспортних засобів, зафіксованих у транспортному потоці або відповідних даних.</rdfs:comment>
        <rdfs:domain rdf:resource="&transport-ontology;VehicleCountData"/>
        <rdfs:range rdf:resource="&xsd;integer"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/transport-ontology#AverageSpeed -->

    <owl:Class rdf:about="&transport-ontology;AverageSpeed">
        <rdfs:label xml:lang="uk">Середня швидкість</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;SystemStateInformation"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#Bus -->

    <owl:Class rdf:about="&transport-ontology;Bus">
        <rdfs:label xml:lang="uk">Автобус</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;Vehicle"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&transport-ontology;hasRoute"/>
                <owl:onClass rdf:resource="&transport-ontology;Route"/>
                <owl:minQualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:minQualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#BusStop -->

    <owl:Class rdf:about="&transport-ontology;BusStop">
        <rdfs:label xml:lang="uk">Транспортна зупинка</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;TransportInfrastructure"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#Car -->

    <owl:Class rdf:about="&transport-ontology;Car">
        <rdfs:label xml:lang="uk">Легковий автомобіль</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;Vehicle"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#CongestionLevel -->

    <owl:Class rdf:about="&transport-ontology;CongestionLevel">
        <rdfs:label xml:lang="uk">Рівень завантаженості</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;SystemStateInformation"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#DataSource -->

    <owl:Class rdf:about="&transport-ontology;DataSource">
        <rdfs:label xml:lang="uk">Джерело даних</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;DigitalTransportModel"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#DecisionRule -->

    <owl:Class rdf:about="&transport-ontology;DecisionRule">
        <rdfs:label xml:lang="uk">Правило прийняття рішення</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;DigitalTransportModel"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#DigitalTransportModel -->

    <owl:Class rdf:about="&transport-ontology;DigitalTransportModel">
        <rdfs:label xml:lang="uk">Цифрова модель транспортної системи</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#GPSMeasurement -->

    <owl:Class rdf:about="&transport-ontology;GPSMeasurement">
        <rdfs:label xml:lang="uk">GPS-вимірювання</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;DataSource"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#Intersection -->

    <owl:Class rdf:about="&transport-ontology;Intersection">
        <rdfs:label xml:lang="uk">Перехрестя</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;TransportInfrastructure"/>
        <rdfs:comment>Елемент транспортної інфраструктури, у якому перетинаються або з&amp;apos;єднуються дорожні напрямки.</rdfs:comment>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#PassengerFlow -->

    <owl:Class rdf:about="&transport-ontology;PassengerFlow">
        <rdfs:label xml:lang="uk">Пасажиропотік</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;TransportProcess"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#PassengerFlowData -->

    <owl:Class rdf:about="&transport-ontology;PassengerFlowData">
        <rdfs:label xml:lang="uk">Дані про пасажиропотік</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;TransportSystemData"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#RoadClosure -->

    <owl:Class rdf:about="&transport-ontology;RoadClosure">
        <rdfs:label xml:lang="uk">Перекриття дороги</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;TransportEvent"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#RoadNetwork -->

    <owl:Class rdf:about="&transport-ontology;RoadNetwork">
        <rdfs:label xml:lang="uk">Дорожня мережа</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;TransportInfrastructure"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#RoadSegment -->

    <owl:Class rdf:about="&transport-ontology;RoadSegment">
        <rdfs:label xml:lang="uk">Дорожній сегмент</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;TransportInfrastructure"/>
        <rdfs:comment>Окрема ділянка дорожньої мережі з визначеними характеристиками довжини, кількості смуг та швидкості руху.</rdfs:comment>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#RoadWorks -->

    <owl:Class rdf:about="&transport-ontology;RoadWorks">
        <rdfs:label xml:lang="uk">Дорожні роботи</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;TransportEvent"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#Route -->

    <owl:Class rdf:about="&transport-ontology;Route">
        <rdfs:label xml:lang="uk">Маршрут</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;TransportObject"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#RouteChange -->

    <owl:Class rdf:about="&transport-ontology;RouteChange">
        <rdfs:label xml:lang="uk">Зміна маршруту</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;TransportDecision"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#SpeedData -->

    <owl:Class rdf:about="&transport-ontology;SpeedData">
        <rdfs:label xml:lang="uk">Дані про швидкість</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;TransportSystemData"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#SpeedSensor -->

    <owl:Class rdf:about="&transport-ontology;SpeedSensor">
        <rdfs:label xml:lang="uk">Датчик швидкості</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;DataSource"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#SystemStateInformation -->

    <owl:Class rdf:about="&transport-ontology;SystemStateInformation">
        <rdfs:label xml:lang="uk">Інформація про стан системи</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;DigitalTransportModel"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#TrafficAccident -->

    <owl:Class rdf:about="&transport-ontology;TrafficAccident">
        <rdfs:label xml:lang="uk">ДТП</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;TransportEvent"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#TrafficFlow -->

    <owl:Class rdf:about="&transport-ontology;TrafficFlow">
        <rdfs:label xml:lang="uk">Транспортний потік</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;TransportProcess"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#TrafficLight -->

    <owl:Class rdf:about="&transport-ontology;TrafficLight">
        <rdfs:label xml:lang="uk">Світлофор</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;TransportInfrastructure"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#TrafficRegulation -->

    <owl:Class rdf:about="&transport-ontology;TrafficRegulation">
        <rdfs:label xml:lang="uk">Регулювання руху</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;TransportDecision"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#TrafficRestriction -->

    <owl:Class rdf:about="&transport-ontology;TrafficRestriction">
        <rdfs:label xml:lang="uk">Обмеження руху</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;TransportDecision"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#TrafficSensor -->

    <owl:Class rdf:about="&transport-ontology;TrafficSensor">
        <rdfs:label xml:lang="uk">Датчик трафіку</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;DataSource"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#TransportDecision -->

    <owl:Class rdf:about="&transport-ontology;TransportDecision">
        <rdfs:label xml:lang="uk">Транспортне рішення</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;DigitalTransportModel"/>
        <owl:disjointWith rdf:resource="&transport-ontology;TransportInfrastructure"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#TransportEvent -->

    <owl:Class rdf:about="&transport-ontology;TransportEvent">
        <rdfs:label xml:lang="uk">Транспортна подія</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;DigitalTransportModel"/>
        <owl:disjointWith rdf:resource="&transport-ontology;TransportInfrastructure"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#TransportInfrastructure -->

    <owl:Class rdf:about="&transport-ontology;TransportInfrastructure">
        <rdfs:label xml:lang="uk">Транспортна інфраструктура</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;DigitalTransportModel"/>
        <owl:disjointWith rdf:resource="&transport-ontology;TransportProcess"/>
        <owl:disjointWith rdf:resource="&transport-ontology;Vehicle"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#TransportObject -->

    <owl:Class rdf:about="&transport-ontology;TransportObject">
        <rdfs:label xml:lang="uk">Транспортний об&apos;єкт</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;DigitalTransportModel"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#TransportProcess -->

    <owl:Class rdf:about="&transport-ontology;TransportProcess">
        <rdfs:label xml:lang="uk">Транспортний процес</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;DigitalTransportModel"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#TransportSystemData -->

    <owl:Class rdf:about="&transport-ontology;TransportSystemData">
        <rdfs:label xml:lang="uk">Дані транспортної системи</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;DigitalTransportModel"/>
    </owl:Class>
    


    <!-- http://example.org/transport-ontology#Truck -->

    <owl:Class rdf:about="&transport-ontology;Truck">
        <rdfs:label xml:lang="uk">Вантажний автомобіль</rdfs:label>
        <rdfs:subClassOf rdf:resource="&transport-ontology;Vehicle"/>
    </owl:Class>
    


