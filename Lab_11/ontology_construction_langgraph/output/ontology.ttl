@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ut: <https://example.org/urban-transport#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ut:Authority_LvivTransport a ut:TransportAuthority ;
    ut:manages ut:Controller_Central_01 ;
    ut:usesPolicy ut:Policy_IncidentResponse .

ut:Bus_204 a ut:PublicTransitVehicle ;
    ut:operatesOn ut:Route_8 .

ut:Incident_Shevchenka_Closure a ut:TrafficIncident ;
    ut:affects ut:RoadSegment_Shevchenka ;
    ut:causes ut:Metric_Shevchenka_Delay .

ut:Sensor_Shevchenka_01 a ut:TrafficSensor ;
    ut:hasIdentifier "TS-SH-01"^^xsd:string ;
    ut:measures ut:RoadSegment_Shevchenka ;
    ut:monitors ut:Observation_SH_0900 .

ut:TrafficSignal a owl:Class ;
    rdfs:label "Traffic Signal"@en,
        "Світлофор"@uk ;
    rdfs:comment "A signal device used to control traffic movement."@en ;
    rdfs:subClassOf ut:Infrastructure .

ut:UrbanTransportationOntology a owl:Ontology ;
    rdfs:label "Digital Models of Urban Transportation Systems"@en,
        "Цифрові моделі транспортних систем"@uk ;
    rdfs:comment "Academic ontology generated by an explicit LangGraph pipeline."@en .

ut:affects a owl:ObjectProperty ;
    rdfs:label "впливає на"@en,
        "affects"@uk ;
    rdfs:comment "An incident affects a road segment."@en ;
    rdfs:domain ut:TrafficIncident ;
    rdfs:range ut:RoadSegment .

ut:causes a owl:ObjectProperty ;
    rdfs:label "causes"@en,
        "спричиняє"@uk ;
    rdfs:comment "An incident can cause a measurable performance effect."@en ;
    rdfs:domain ut:TrafficIncident ;
    rdfs:range ut:PerformanceMetric .

ut:connectsTo a owl:ObjectProperty ;
    rdfs:label "з'єднується з"@en,
        "з'єднує"@uk ;
    rdfs:comment "A road segment connects to another road segment."@en ;
    rdfs:domain ut:RoadSegment ;
    rdfs:range ut:RoadSegment .

ut:evaluates a owl:ObjectProperty ;
    rdfs:label "оцінює"@en,
        "evaluates"@uk ;
    rdfs:comment "A performance metric evaluates a road segment."@en ;
    rdfs:domain ut:PerformanceMetric ;
    rdfs:range ut:RoadSegment .

ut:hasAllowedSpeed a owl:DatatypeProperty ;
    rdfs:label "has allowed speed"@en,
        "має дозволену швидкість"@uk ;
    rdfs:comment "Allowed speed in km/h."@en ;
    rdfs:domain ut:RoadSegment ;
    rdfs:range xsd:float .

ut:hasDelayMinutes a owl:DatatypeProperty ;
    rdfs:label "has delay in minutes"@en,
        "має затримку в хвилинах"@uk ;
    rdfs:comment "Delay represented in minutes."@en ;
    rdfs:domain ut:PerformanceMetric ;
    rdfs:range xsd:float .

ut:hasDescription a owl:DatatypeProperty ;
    rdfs:label "has description"@en,
        "має опис"@uk ;
    rdfs:comment "Human-readable policy description."@en ;
    rdfs:domain ut:GovernancePolicy ;
    rdfs:range xsd:string .

ut:hasIdentifier a owl:DatatypeProperty ;
    rdfs:label "has identifier"@en,
        "має ідентифікатор"@uk ;
    rdfs:comment "Persistent identifier of a sensor."@en ;
    rdfs:domain ut:TrafficSensor ;
    rdfs:range xsd:string .

ut:hasLanesCount a owl:DatatypeProperty ;
    rdfs:label "has lane count"@en,
        "має кількість смуг"@uk ;
    rdfs:comment "Number of lanes."@en ;
    rdfs:domain ut:RoadSegment ;
    rdfs:range xsd:integer .

ut:hasObservedSpeed a owl:DatatypeProperty ;
    rdfs:label "has observed speed"@en,
        "має спостережену швидкість"@uk ;
    rdfs:comment "Observed speed in km/h."@en ;
    rdfs:domain ut:TrafficObservation ;
    rdfs:range xsd:float .

ut:hasRouteNumber a owl:DatatypeProperty ;
    rdfs:label "has route number"@en,
        "має номер маршруту"@uk ;
    rdfs:comment "Public transit route identifier."@en ;
    rdfs:domain ut:TransitRoute ;
    rdfs:range xsd:string .

ut:hasTimestamp a owl:DatatypeProperty ;
    rdfs:label "has timestamp"@en,
        "має часову мітку"@uk ;
    rdfs:comment "Observation timestamp."@en ;
    rdfs:domain ut:TrafficObservation ;
    rdfs:range xsd:dateTime .

ut:hasVehicleCount a owl:DatatypeProperty ;
    rdfs:label "has vehicle count"@en,
        "має кількість транспортних засобів"@uk ;
    rdfs:comment "Observed vehicle count."@en ;
    rdfs:domain ut:TrafficObservation ;
    rdfs:range xsd:integer .

ut:isPeakHour a owl:DatatypeProperty ;
    rdfs:label "is peak hour"@en,
        "є годиною пік"@uk ;
    rdfs:comment "Whether the observation belongs to a peak period."@en ;
    rdfs:domain ut:TrafficObservation ;
    rdfs:range xsd:boolean .

ut:manages a owl:ObjectProperty ;
    rdfs:label "manages"@en,
        "керує"@uk ;
    rdfs:comment "An authority manages a traffic controller."@en ;
    rdfs:domain ut:TransportAuthority ;
    rdfs:range ut:TrafficController .

ut:monitors a owl:ObjectProperty ;
    rdfs:label "monitors"@en,
        "моніторить"@uk ;
    rdfs:comment "A sensor is associated with observations it monitors."@en ;
    rdfs:domain ut:TrafficSensor ;
    rdfs:range ut:TrafficObservation .

ut:operatesOn a owl:ObjectProperty ;
    rdfs:label "працює на"@en,
        "operates on"@uk ;
    rdfs:comment "A public transit vehicle operates on a route."@en ;
    rdfs:domain ut:PublicTransitVehicle ;
    rdfs:range ut:TransitRoute .

ut:regulates a owl:ObjectProperty ;
    rdfs:label "regulates"@en,
        "регулює"@uk ;
    rdfs:comment "A controller regulates traffic on a road segment."@en ;
    rdfs:domain ut:TrafficController ;
    rdfs:range ut:RoadSegment .

ut:serves a owl:ObjectProperty ;
    rdfs:label "обслуговує"@en,
        "serves"@uk ;
    rdfs:comment "A transit route serves a road segment."@en ;
    rdfs:domain ut:TransitRoute ;
    rdfs:range ut:RoadSegment .

ut:usesPolicy a owl:ObjectProperty ;
    rdfs:label "застосовує політику"@en,
        "uses policy"@uk ;
    rdfs:comment "An authority applies a governance policy."@en ;
    rdfs:domain ut:TransportAuthority ;
    rdfs:range ut:GovernancePolicy .

ut:AdaptiveSignal_Shevchenka a ut:AdaptiveSignal ;
    ut:controlsIntersection ut:Intersection_Shevchenka_Center .

ut:AdaptiveSignal_controlsIntersection_Restriction a owl:Restriction ;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass ut:SignalizedIntersection ;
    owl:onProperty ut:controlsIntersection .

ut:Controller_Central_01 a ut:TrafficController ;
    ut:controls ut:AdaptiveSignal_Shevchenka ;
    ut:regulates ut:RoadSegment_Shevchenka .

ut:Event a owl:Class ;
    rdfs:label "Event"@en,
        "Event"@uk ;
    rdfs:comment "Taxonomy grouping for Event concepts."@en .

ut:Intersection_Shevchenka_Center a ut:SignalizedIntersection .

ut:Metric_Shevchenka_Delay a ut:PerformanceMetric ;
    ut:evaluates ut:RoadSegment_Shevchenka ;
    ut:hasDelayMinutes "12.7"^^xsd:float .

ut:Observation_SH_0900 a ut:TrafficObservation ;
    ut:hasObservedSpeed "24.5"^^xsd:float ;
    ut:hasTimestamp "2026-09-30T09:00:00"^^xsd:dateTime ;
    ut:hasVehicleCount 183 ;
    ut:isPeakHour true .

ut:Policy_IncidentResponse a ut:GovernancePolicy ;
    ut:hasDescription "Activate incident response, coordinate signals, and publish a transit detour."^^xsd:string .

ut:RoadSegment_Franko a ut:RoadSegment ;
    ut:hasAllowedSpeed "50.0"^^xsd:float ;
    ut:hasLanesCount 2 .

ut:RoadSegment_Lychakivska a ut:RoadSegment ;
    ut:hasAllowedSpeed "50.0"^^xsd:float ;
    ut:hasLanesCount 2 .

ut:Route_8 a ut:TransitRoute ;
    ut:hasRouteNumber "8"^^xsd:string ;
    ut:serves ut:RoadSegment_Shevchenka .

ut:TrafficController_controls_Restriction a owl:Restriction ;
    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass ut:AdaptiveSignal ;
    owl:onProperty ut:controls .

ut:TrafficSensor_measures_Restriction a owl:Restriction ;
    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass ut:RoadSegment ;
    owl:onProperty ut:measures .

ut:controls a owl:ObjectProperty ;
    rdfs:label "controls"@en,
        "керує"@uk ;
    rdfs:comment "A controller operates an adaptive signal."@en ;
    rdfs:domain ut:TrafficController ;
    rdfs:range ut:AdaptiveSignal .

ut:controlsIntersection a owl:ObjectProperty ;
    rdfs:label "controls intersection"@en,
        "керує перехрестям"@uk ;
    rdfs:comment "An adaptive signal controls exactly one signalized intersection."@en ;
    rdfs:domain ut:AdaptiveSignal ;
    rdfs:range ut:SignalizedIntersection .

ut:measures a owl:ObjectProperty ;
    rdfs:label "measures"@en,
        "вимірює"@uk ;
    rdfs:comment "A sensor measures conditions on a road segment."@en ;
    rdfs:domain ut:TrafficSensor ;
    rdfs:range ut:RoadSegment .

ut:Governance a owl:Class ;
    rdfs:label "Governance"@en,
        "Governance"@uk ;
    rdfs:comment "Taxonomy grouping for Governance concepts."@en .

ut:MobilityService a owl:Class ;
    rdfs:label "MobilityService"@en,
        "MobilityService"@uk ;
    rdfs:comment "Taxonomy grouping for MobilityService concepts."@en .

ut:PublicTransitVehicle a owl:Class ;
    rdfs:label "Public Transit Vehicle"@en,
        "Транспортний засіб громадського транспорту"@uk ;
    rdfs:comment "A vehicle operating a public-transit service."@en ;
    rdfs:subClassOf ut:MobilityService .

ut:Observation a owl:Class ;
    rdfs:label "Observation"@en,
        "Observation"@uk ;
    rdfs:comment "Taxonomy grouping for Observation concepts."@en .

ut:SignalizedIntersection a owl:Class ;
    rdfs:label "Signalized Intersection"@en,
        "Регульоване перехрестя"@uk ;
    rdfs:comment "An intersection represented as the location controlled by a signal."@en ;
    rdfs:subClassOf ut:Infrastructure .

ut:TrafficIncident a owl:Class ;
    rdfs:label "Traffic Incident"@en,
        "Дорожній інцидент"@uk ;
    rdfs:comment "A temporary event disrupting transportation operations."@en ;
    rdfs:subClassOf ut:Event ;
    owl:disjointWith ut:PerformanceMetric .

ut:TransportAuthority a owl:Class ;
    rdfs:label "Transport Authority"@en,
        "Транспортний орган"@uk ;
    rdfs:comment "An organization responsible for transport governance and operations."@en ;
    rdfs:subClassOf ut:Governance .

ut:AdaptiveSignal a owl:Class ;
    rdfs:label "Adaptive Signal"@en,
        "Адаптивний світлофор"@uk ;
    rdfs:comment "A traffic signal whose operation can adapt to observed conditions."@en ;
    rdfs:subClassOf ut:AdaptiveSignal_controlsIntersection_Restriction,
        ut:Infrastructure .

ut:GovernancePolicy a owl:Class ;
    rdfs:label "Governance Policy"@en,
        "Політика управління"@uk ;
    rdfs:comment "A normative rule or procedure governing transportation operations."@en ;
    rdfs:subClassOf ut:Governance .

ut:TrafficController a owl:Class ;
    rdfs:label "Traffic Controller"@en,
        "Контролер руху"@uk ;
    rdfs:comment "A control resource that operates traffic signals and regulates traffic."@en ;
    rdfs:subClassOf ut:Infrastructure,
        ut:TrafficController_controls_Restriction ;
    owl:disjointWith ut:GovernancePolicy .

ut:Infrastructure a owl:Class ;
    rdfs:label "Infrastructure"@en,
        "Infrastructure"@uk ;
    rdfs:comment "Taxonomy grouping for Infrastructure concepts."@en .

ut:PerformanceMetric a owl:Class ;
    rdfs:label "Performance Metric"@en,
        "Показник ефективності"@uk ;
    rdfs:comment "A quantitative indicator used to evaluate transport performance."@en ;
    rdfs:subClassOf ut:Observation .

ut:RoadSegment_Shevchenka a ut:RoadSegment ;
    ut:connectsTo ut:RoadSegment_Franko,
        ut:RoadSegment_Lychakivska ;
    ut:hasAllowedSpeed "50.0"^^xsd:float ;
    ut:hasLanesCount 2 .

ut:TrafficSensor a owl:Class ;
    rdfs:label "Traffic Sensor"@en,
        "Дорожній датчик"@uk ;
    rdfs:comment "A device that observes traffic conditions."@en ;
    rdfs:subClassOf ut:Observation,
        ut:TrafficSensor_measures_Restriction .

ut:TransitRoute a owl:Class ;
    rdfs:label "Transit Route"@en,
        "Маршрут громадського транспорту"@uk ;
    rdfs:comment "A public-transit service route."@en ;
    rdfs:subClassOf ut:MobilityService .

ut:TrafficObservation a owl:Class ;
    rdfs:label "Traffic Observation"@en,
        "Спостереження за рухом"@uk ;
    rdfs:comment "A timestamped measurement of traffic conditions."@en ;
    rdfs:subClassOf ut:Observation ;
    owl:disjointWith ut:TransitRoute .

ut:RoadSegment a owl:Class ;
    rdfs:label "Road Segment"@en,
        "Дорожня ділянка"@uk ;
    rdfs:comment "A modeled portion of an urban road network."@en ;
    rdfs:subClassOf ut:Infrastructure ;
    owl:disjointWith ut:TrafficSensor .

