@prefix ut: <https://example.org/urban-transport#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ut:RoadSegmentShape a sh:NodeShape ;
    sh:targetClass ut:RoadSegment ;
    sh:property [ sh:path ut:hasAllowedSpeed ; sh:datatype xsd:float ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 10.0 ; sh:maxInclusive 130.0 ] ;
    sh:property [ sh:path ut:hasLanesCount ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] .

ut:TrafficSensorShape a sh:NodeShape ;
    sh:targetClass ut:TrafficSensor ;
    sh:property [ sh:path ut:hasIdentifier ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path ut:measures ; sh:class ut:RoadSegment ; sh:minCount 1 ] .

ut:TrafficObservationShape a sh:NodeShape ;
    sh:targetClass ut:TrafficObservation ;
    sh:property [ sh:path ut:hasObservedSpeed ; sh:datatype xsd:float ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0.0 ] ;
    sh:property [ sh:path ut:hasVehicleCount ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] ;
    sh:property [ sh:path ut:isPeakHour ; sh:datatype xsd:boolean ; sh:minCount 1 ; sh:maxCount 1 ] .
